# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
.angular

/.nx/workspace-data

# Feature specifications are point-in-time records written by humans and
# spec-kit agents. They are documentation of past decisions, not maintained
# source, so reformatting them only creates churn and diff noise.
/specs

# Agent and spec-kit tooling definitions. These are vendored/generated by
# their own tools (Claude Code, spec-kit) and rewritten wholesale on update,
# so formatting them only fights the generator.
/.claude
/.specify

# Sequelize migrations and seeders are append-only historical records — a
# migration is never edited after it has run anywhere. Includes the
# deliberately-committed seeders/utils/dist build output.
/database

# Long-form internal documentation, including the point-in-time
# docs/estimates/** feature write-ups.
/docs

# Generated or externally-owned config.
/maqa-config.yml
/.github/workflows
