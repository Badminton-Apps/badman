# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
.angular

/.nx/workspace-data

# Markdown is prose, not source. Prettier reflows tables and wraps text in
# ways that produce large diffs with no reader benefit, and every doc in this
# repo (docs/, specs/, estimates, package READMEs, agent instructions) is
# hand-written or generated. Formatting is left to the author.
**/*.md

# Feature specifications are point-in-time records written by humans and
# spec-kit agents — documentation of past decisions, not maintained source.
# (The markdown rule above covers most of it; this also catches the
# contracts/*.graphql fixtures.)
/specs

# Agent and spec-kit tooling definitions. These are vendored/generated by
# their own tools (Claude Code, spec-kit) and rewritten wholesale on update,
# so formatting them only fights the generator.
/.claude
/.specify

# Sequelize migrations and seeders are append-only historical records — a
# migration is never edited after it has run anywhere. Includes the
# deliberately-committed seeders/utils/dist build output.
/database

# Generated or externally-owned config.
/maqa-config.yml
/.github/workflows

# Written by tooling, not by hand: pnpm rewrites the lockfile on every
# install and the CLA bot owns the signature file.
/pnpm-lock.yaml
/signatures

# Prettier's glimmer parser cannot parse these: it rejects Handlebars
# partials ({{> layout/footer }}) and parent-context lookups ({{../foo}}),
# both of which these mail templates legitimately use. They are hard parse
# errors, not style warnings, and were failing `format:check` outright.
**/*.handlebars
