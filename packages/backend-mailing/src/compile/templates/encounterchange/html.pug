extends ../../layouts/layout.pug

block title
  h1.text-center
    | Verplaatsingsaanvraag

block content
  p.text-center
    p
      | Beste #{ captain },
      br
      br
      if action === "ENDORSE"
        | #{ actingTeamName } heeft een voorgestelde datum goedgekeurd voor de ontmoeting tussen #{ encounter.home.name } en #{ encounter.away.name }.
      else if action === "REJECT"
        | #{ actingTeamName } heeft de voorgestelde datums afgewezen voor de ontmoeting tussen #{ encounter.home.name } en #{ encounter.away.name }.
      else if action === "COUNTER"
        | #{ actingTeamName } heeft tegendatums voorgesteld voor de ontmoeting tussen #{ encounter.home.name } en #{ encounter.away.name }.
      else
        | #{ actingTeamName } heeft een aanvraag ingediend om de ontmoeting tussen #{ encounter.home.name } en #{ encounter.away.name } te verplaatsen.
    p
      a(href=url)
        | Klik hier om het verzoek te bekijken

    br
    br
    | Met vriendelijke groet,
    br
    | Badman
