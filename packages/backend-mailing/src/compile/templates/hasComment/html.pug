extends ../../layouts/layout.pug

block title
  h1.text-center
    | Ontmoeting heeft een opmerking

block content
  p.text-center
    p
      | Beste #{ contact }, 
      br
      br
      |
      | De ontmoeting
      strong #{ encounter.home.name }
      |
      | tegen
      strong #{ encounter.away.name }
      |
      | op
      strong #{ date }
      |
      | heeft een opmerking.
      br
    if comments && comments.length
      each comment in comments
        p
          em
            | "#{ comment.message }"
          if comment.user
            br
            small
              | — #{ comment.user }
              if comment.date
                |
                | (#{ comment.date })
    p
      a(href=`${url}`)
        if externalLink
          | Bekijk de opmerking op toernooi.nl
        else
          | Ga naar ontmoeting
    p
      | Met sportieve groeten,
      br
      |
      | Badman
