# =============================================================================
# Badman backend environment
# =============================================================================
# Copy to `.env` (git-ignored). The defaults below work for local development
# with `npm run docker:up`; only the "Ask the team" values must be filled in.
# docker-compose.dev.yml reads DB_USER / DB_PASSWORD / DB_DATABASE from this
# file to initialise the Postgres container on its first start.
#
# Variables are validated at boot by packages/utils/src/config/configuration.ts.
# For migrations/seeds against another environment, see database/seeders/README.md.

NODE_ENV=development
# PORT=5010

# =============================================================================
# Database (local docker Postgres + PostGIS)
# =============================================================================
DB_IP=127.0.0.1
DB_PORT=5432
DB_DATABASE=badman
DB_USER=badman
DB_PASSWORD=badman
DB_DIALECT=postgres
# DB_SSL=false
# DB_LOGGING=false
# DB_SLOW_QUERY_MS=

# =============================================================================
# Redis (local docker Redis: queues, websockets, optional cache)
# =============================================================================
# Use `localhost` when the API runs on your machine. `redis` only resolves
# inside the docker network.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set DB_CACHE=true in production to offload Nest cache-manager to Redis.
DB_CACHE=false

# =============================================================================
# Clients (required)
# =============================================================================
# badman-frontend dev server
CLIENT_URL=http://localhost:3001
# Required by config validation; the legacy Angular client no longer exists.
LEGACY_CLIENT_URL=http://localhost:3000

# =============================================================================
# Auth0 (required) — ask the team
# =============================================================================
AUTH0_ISSUER_URL=
AUTH0_AUDIENCE=

# =============================================================================
# Toernooi.nl / Visual (VR_API is required)
# =============================================================================
# The default is a deliberately unreachable placeholder so nothing can talk to
# toernooi.nl by accident. Ask the team for real values only when you work on
# the sync, and read the worker warning in README.md first.
VR_API=http://127.0.0.1:1
# VR_API_USER=
# VR_API_PASS=

# =============================================================================
# Side effects — keep these OFF locally unless you know what you are doing
# =============================================================================
# Write scores / date changes / acceptances to toernooi.nl (sync worker)
ENTER_SCORES_ENABLED=false
VR_CHANGE_DATES=false
VR_ACCEPT_ENCOUNTERS=false
# Show the headless browser of the sync worker (debugging only)
VISUAL_SYNC_ENABLED=false
# Leave browser instances open after a sync job (debugging only)
# HANG_BEFORE_BROWSER_CLEANUP=false

# Mail. When enabled, DEV_EMAIL_DESTINATION receives the dev-only mails.
MAIL_ENABLED=false
MAIL_PROVIDER=smtp # smtp | resend
# MAIL_HOST=
# MAIL_USER=
# MAIL_PASS=
# RESEND_API_KEY=
# MAIL_SUBJECT_PREFIX=
# DEV_EMAIL_DESTINATION=

# Web push. VAPID keys are required when PUSH_ENABLED=true.
PUSH_ENABLED=false
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=

# =============================================================================
# Optional integrations (leave empty locally)
# =============================================================================
# Twizzit (required in staging/production only)
# TWIZZIT_API=
# TWIZZIT_API_USER=
# TWIZZIT_API_PASS=

# CP export (see docs/guides/cp-export-deployment.md)
# CP_PASS=
# CP_CALLBACK_URL=
# CP_WEBHOOK_SECRET=
# GH_TOKEN_CP=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# Monitoring
# SENTRY_DSN=
# LOGTAIL_TOKEN=

# Deploy only (required in staging/production, unused locally)
# APOLLO_GRAPH_REF=
# RENDER_API_URL=
# RENDER_API_KEY=

# =============================================================================
# Dev-only queue shortcuts (forbidden in staging/production)
# =============================================================================
# Lets scripts enqueue jobs without a JWT, acting as the given player (needs
# the change:job permission). See docs/enter-scores-local-browser.md.
# DEV_ONLY_ALLOW_QUEUE_JOB_WITHOUT_AUTH=false
# DEV_ONLY_QUEUE_JOB_AS_PLAYER_ID=

# =============================================================================
# Seeders (npm run seed:test-data / seed:admin) — see database/seeders/README.md
# =============================================================================
# Put your own Auth0 `sub` (auth0|...) in *_AUTH0_SUB to log in as that player.
SEED_ADMIN_USER_EMAIL=admin@testtest.be
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Adminson
SEED_ADMIN_GENDER=M
# SEED_ADMIN_MEMBER_ID=
# SEED_ADMIN_USER_AUTH0_SUB=

SEED_HOMETEAM_USER_EMAIL=home@testtest.be
SEED_HOMETEAM_FIRST_NAME=Home
SEED_HOMETEAM_LAST_NAME=Captain
SEED_HOMETEAM_GENDER=M
# SEED_HOMETEAM_MEMBER_ID=
# SEED_HOMETEAM_USER_AUTH0_SUB=

SEED_AWAYTEAM_USER_EMAIL=away@testtest.be
SEED_AWAYTEAM_FIRST_NAME=Away
SEED_AWAYTEAM_LAST_NAME=Captain
SEED_AWAYTEAM_GENDER=F
# SEED_AWAYTEAM_MEMBER_ID=
# SEED_AWAYTEAM_USER_AUTH0_SUB=
